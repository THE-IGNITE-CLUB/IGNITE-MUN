# ──────────────────────────────────────────────
# IGNITE MUN 2026 — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.
# ──────────────────────────────────────────────

# Flask secret key (use a long random string in production)
FLASK_SECRET_KEY=change_this_to_a_long_random_secret_key

# Gmail credentials for sending emails (use a Gmail App Password)
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Admin contact email (receives staff application notifications)
ADMIN_EMAIL=your_email@gmail.com

# Razorpay payment gateway keys (from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Conference settings
FREE_SLOTS=10
CONFERENCE_DATE=2026-12-01T07:00:00+05:30
